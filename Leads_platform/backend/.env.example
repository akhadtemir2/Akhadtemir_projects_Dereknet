# Скопируй в backend/.env и подставь свои значения. .env в .gitignore — НЕ коммить.

# Supabase (Postgres) — база лидов
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_KEY

# OpenAI — AI-скоринг лидов
OPENAI_API_KEY=sk-...

# Telegram — уведомления (бот) и парсинг (Telethon user-сессия)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
TG_API_ID=1234567
TG_API_HASH=your_telegram_api_hash
# base64 сохранённой Telethon-сессии (альтернатива файлу tg_session.session)
TG_SESSION_B=

# Instagram — парсинг (instagrapi)
IG_USERNAME=
IG_PASSWORD=
IG_PROXY=
IG_SESSION_B=

# 2GIS — парсинг организаций
TWOGIS_API_KEY=

# Прочее
FRONTEND_URL=http://localhost:5173
PORT=8000
